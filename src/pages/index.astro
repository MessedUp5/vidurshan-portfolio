---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import LiquidEther from '../components/LiquidEther.astro';
---

<Layout>
  <LiquidEther />
  <Navigation />

  <main>
    <Hero />

    <section id="about" class="content-section about-section">
      <div class="section-heading">
        <span></span>
        <h2>About</h2>
      </div>

      <div class="about-grid">
        <div class="about-text">
          <p>
            I'm an Information Systems undergraduate at the
            <strong> University of Colombo School of Computing</strong>, building a career at the
            intersection of business analysis and software engineering.
          </p>

          <p>
            I enjoy understanding how systems and processes work, identifying problems, and
            translating business requirements into practical technical solutions.
          </p>

          <p>
            My experience spans requirements engineering, process mapping, user stories, acceptance
            criteria, Agile collaboration, and software development.
          </p>

          <p>
            Currently, I'm seeking internship opportunities in
            <strong> Business Analysis</strong> and
            <strong> Software Engineering</strong>, where I can contribute to real-world projects
            while developing my professional and technical skills.
          </p>
        </div>

        <div class="about-photo">
          <div class="photo-frame">
            <img src={`${import.meta.env.BASE_URL}/profile.jpeg`} alt="Vidurshan Ponmudy" />
          </div>
        </div>
      </div>
    </section>

    <section id="experience" class="content-section experience-section">
      <div class="section-heading">
        <h2>Experience</h2>
      </div>

      <div class="experience-list">
        <article class="experience-item">
          <div class="experience-header">
            <div>
              <h3>Treasurer</h3>
              <p class="experience-company">Rotaract Club of UCSC</p>
              <span class="experience-date">Jun 2026 — Present</span>
            </div>

            <span class="experience-date">Volunteering Experience</span>
          </div>

          <ul class="experience-details">
            <li>
              Support financial planning and budget management for club activities and initiatives.
            </li>
            <li>
              Assist with tracking expenses, maintaining financial records, and promoting
              accountability.
            </li>
            <li>
              Coordinate with the club board and project teams to support events and organizational
              activities.
            </li>
          </ul>
        </article>
        <article class="experience-item">
          <div class="experience-header">
            <div>
              <h3>Customer Service Representative</h3>
              <p class="experience-company">Dialog Axiata PLC</p>
              <span class="experience-date">Apr 2023 – May 2024</span>
            </div>

            <span class="experience-date">Professional Experience</span>
          </div>

          <ul class="experience-details">
            <li>
              Handled customer enquiries across Dialog TV, broadband, and prepaid and postpaid
              services.
            </li>
            <li>
              Investigated customer issues and communicated appropriate solutions clearly and
              effectively.
            </li>
            <li>
              Developed strong communication, problem-solving, and customer-handling skills through
              direct customer interaction.
            </li>
          </ul>

          <div class="experience-tags">
            <span>Customer Success</span>
            <span>Problem Solving</span>
            <span>Communication</span>
            <span>Teamwork</span>
          </div>
        </article>
      </div>
    </section>

    <section id="projects" class="content-section projects-section">
      <div class="section-heading">
        <h2>Projects</h2>
      </div>

      <!-- Featured Project -->
      <article class="featured-project">
        <div class="featured-project-content">
          <p class="project-label">Featured Project - Group Project</p>

          <h3>GridX</h3>

          <h4>Peer-to-Peer Energy Trading Platform</h4>

          <p class="project-description">
            A peer-to-peer energy trading platform designed to connect prosumers and consumers
            through a simulated energy marketplace. The platform uses price-time matching to
            facilitate energy trading while providing market and transaction management features.
          </p>

          <div class="project-tags">
            <span>Business Analysis</span>
            <span>Jira</span>
            <span>Confluence</span>
            <span>TypeScript</span>
            <span>Node.js</span>
            <span>PostgreSQL</span>
            <span>gRPC</span>
            <span>Docker</span>
            <span>Kafka</span>
          </div>

          <div class="project-link">
            <a
              href="https://github.com/p2p-energy-trading-platform"
              aria-label="View GridX project"
              target="_blank"
              rel="noopener noreferrer"
            >
              View project <span>↗</span>
            </a>
          </div>
        </div>

        <div class="featured-project-visual">
          <div class="gridx-dashboard">
            <div class="gridx-topbar">
              <div>
                <span class="gridx-brand">GRIDX</span>
                <span class="gridx-market">ENERGY MARKET</span>
              </div>
              <span class="gridx-status">
                <span></span>
                MARKET OPEN
              </span>
            </div>

            <div class="gridx-stats">
              <div class="gridx-stat">
                <span>ENERGY TRADED</span>
                <strong>1,284.50</strong>
                <small>kWh</small>
              </div>

              <div class="gridx-stat">
                <span>MARKET PRICE</span>
                <strong>0.082</strong>
                <small>credits / kWh</small>
              </div>

              <div class="gridx-stat">
                <span>ACTIVE ORDERS</span>
                <strong>47</strong>
                <small>orders</small>
              </div>
            </div>

            <div class="gridx-market-grid">
              <div class="gridx-chart">
                <div class="gridx-panel-heading">
                  <span>MARKET ACTIVITY</span>
                  <span>24H</span>
                </div>

                <div class="gridx-chart-area">
                  <div class="chart-line"></div>
                  <div class="chart-point point-one"></div>
                  <div class="chart-point point-two"></div>
                  <div class="chart-point point-three"></div>
                  <div class="chart-point point-four"></div>
                </div>
              </div>

              <div class="gridx-orderbook">
                <div class="gridx-panel-heading">
                  <span>ORDER BOOK</span>
                  <span>PRICE / kWh</span>
                </div>

                <div class="order-row sell">
                  <span>SELL</span>
                  <strong>0.091</strong>
                  <small>120</small>
                </div>

                <div class="order-row sell">
                  <span>SELL</span>
                  <strong>0.087</strong>
                  <small>85</small>
                </div>

                <div class="order-row current">
                  <span>LAST</span>
                  <strong>0.082</strong>
                  <small>64</small>
                </div>

                <div class="order-row buy">
                  <span>BUY</span>
                  <strong>0.079</strong>
                  <small>92</small>
                </div>

                <div class="order-row buy">
                  <span>BUY</span>
                  <strong>0.075</strong>
                  <small>146</small>
                </div>
              </div>
            </div>

            <div class="gridx-footer">
              <span>PRICE-TIME MATCHING</span>
              <span>SIMULATED ENERGY MARKET</span>
            </div>
          </div>
        </div>
      </article>

      <!-- Other Projects -->
      <div class="project-grid">
        <article class="project-card">
          <div class="project-card-top">
            <span class="project-number">01</span>
            <a
              href="https://github.com/Sesandii/autonexusNew"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="View AutoNexus project"
              class="project-arrow"
            >
              ↗
            </a>
          </div>

          <div class="project-card-content">
            <p class="project-type">Group Project</p>

            <h3>AutoNexus</h3>

            <h4>Vehicle Service Management System</h4>

            <p>
              A vehicle service management system designed to streamline appointments, work orders,
              mechanic assignment, service tracking, and operational workflows.
            </p>

            <div class="project-tags">
              <span>Business Analysis</span>
              <span>BPMN</span>
              <span>PHP</span>
              <span>MYSQL</span>
              <span>HTML/CSS/JS</span>
            </div>
          </div>
        </article>

        <article class="project-card">
          <div class="project-card-top">
            <span class="project-number">02</span>

            <a
              href="https://github.com/VMANFdo/Middleware-Architecture-for-SwiftLogistics-"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="View SwiftLogistics project"
              class="project-arrow"
            >
              ↗
            </a>
          </div>

          <div class="project-card-content">
            <p class="project-type">Group Project</p>

            <h3>SwiftLogistics</h3>

            <h4>Middleware Architecture</h4>

            <p>
              A middleware architecture project developed around service integration and
              communication within a logistics-oriented software system.
            </p>

            <div class="project-tags">
              <span>Middleware</span>
              <span>Architecture</span>
              <span>APIs</span>
              <span>Docker</span>
            </div>
          </div>
        </article>

        <article class="project-card">
          <div class="project-card-top">
            <span class="project-number">03</span>

            <a
              href="https://github.com/MessedUp5/zovro-ride-sharing"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="View Zovro project"
              class="project-arrow"
            >
              ↗
            </a>
          </div>

          <div class="project-card-content">
            <p class="project-type">Individual Project</p>

            <h3>Zovro</h3>

            <h4>Ride-Hailing Platform</h4>

            <p>
              A software engineering project focused on designing and implementing a practical
              digital solution with a user-centered approach.
            </p>

            <div class="project-tags">
              <span>React</span>
              <span>Node.js</span>
              <span>PostgreSQL</span>
              <span>Firebase</span>
              <span>Vercel</span>
            </div>
          </div>
        </article>
      </div>
    </section>

    <section id="skills" class="content-section skills-section">
      <div class="section-heading">
        <h2>Skills</h2>
      </div>

      <div class="skills-intro">
        <p>
          A combination of business analysis, software engineering, and project coordination skills
          developed through academic, project, and professional experience.
        </p>
      </div>

      <div class="skills-grid">
        <!-- Business Analysis -->
        <article class="skill-group skill-group-primary">
          <div class="skill-group-header">
            <span class="skill-label">CORE</span>
          </div>

          <h3>Business Analysis</h3>

          <div class="skill-tag-list">
            <span>Requirements Elicitation</span>
            <span>User Stories</span>
            <span>Acceptance Criteria</span>
            <span>Process Mapping</span>
            <span>Functional Specifications</span>
            <span>UML &amp; BPMN</span>
          </div>
        </article>

        <!-- Software Engineering -->
        <article class="skill-group">
          <div class="skill-group-header">
            <span class="skill-label">TECHNICAL</span>
          </div>

          <h3>Software Engineering</h3>

          <div class="technology-grid">
            <div class="technology-item">
              <img src="https://cdn.simpleicons.org/typescript" alt="TypeScript" />
              <span>TypeScript</span>
            </div>

            <div class="technology-item">
              <img src="https://cdn.simpleicons.org/javascript" alt="JavaScript" />
              <span>JavaScript</span>
            </div>

            <div class="technology-item">
              <img src="https://cdn.simpleicons.org/python" alt="Python" />
              <span>Python</span>
            </div>

            <div class="technology-item">
              <img src="https://cdn.simpleicons.org/cplusplus" alt="C++" />
              <span>C++</span>
            </div>

            <div class="technology-item">
              <img src="https://cdn.simpleicons.org/react" alt="React" />
              <span>React</span>
            </div>

            <div class="technology-item">
              <img src="https://cdn.simpleicons.org/nodedotjs" alt="Node.js" />
              <span>Node.js</span>
            </div>

            <div class="technology-item">
              <img src="https://cdn.simpleicons.org/php" alt="PHP" />
              <span>PHP</span>
            </div>

            <div class="technology-item">
              <img src="https://cdn.simpleicons.org/html5" alt="HTML5" />
              <span>HTML5</span>
            </div>

            <div class="technology-item">
              <img src="https://cdn.simpleicons.org/css" alt="CSS3" />
              <span>CSS3</span>
            </div>
          </div>
        </article>

        <!-- Data & Infrastructure -->
        <article class="skill-group">
          <div class="skill-group-header">
            <span class="skill-label">DATA &amp; SYSTEMS</span>
          </div>

          <h3>Data &amp; Infrastructure</h3>

          <div class="technology-grid">
            <div class="technology-item">
              <img src="https://cdn.simpleicons.org/postgresql" alt="PostgreSQL" />
              <span>PostgreSQL</span>
            </div>

            <div class="technology-item">
              <img src="https://cdn.simpleicons.org/mysql" alt="MySQL" />
              <span>MySQL</span>
            </div>

            <div class="technology-item">
              <img src="https://cdn.simpleicons.org/docker" alt="Docker" />
              <span>Docker</span>
            </div>

            <div class="technology-item">
              <img src="https://cdn.simpleicons.org/apachekafka" alt="Kafka" />
              <span>Kafka</span>
            </div>

            <div class="technology-item">
              <img src="https://cdn.simpleicons.org/git" alt="Git" />
              <span>Git</span>
            </div>

            <div class="technology-item">
              <img src="https://cdn.simpleicons.org/github" alt="GitHub" />
              <span>GitHub</span>
            </div>

            <div class="technology-item">
              <img src="https://cdn.simpleicons.org/linux" alt="Linux" />
              <span>Linux</span>
            </div>
          </div>
        </article>

        <!-- Tools & Methodologies -->
        <article class="skill-group">
          <div class="skill-group-header">
            <span class="skill-label">WORKFLOW</span>
          </div>

          <h3>Tools &amp; Methodologies</h3>

          <div class="skill-tag-list">
            <span>Agile / Scrum</span>
            <span>Jira</span>
            <span>Confluence</span>
            <span>Figma</span>
            <span>VS Code</span>
            <span>REST &amp; gRPC</span>
            <span>Sprint Planning</span>
            <span>Project Coordination</span>
          </div>
        </article>
      </div>
    </section>

    <section id="education" class="content-section education-section">
      <div class="section-heading">
        <h2>Education</h2>
      </div>

      <div class="education-list">
        <!-- University -->
        <article class="education-item">
          <div class="education-header">
            <div>
              <h3>Bachelor of Information Systems</h3>
              <p class="education-institution">University of Colombo School of Computing</p>
            </div>

            <span class="education-date">2023 — Present</span>
          </div>

          <p class="education-description">
            An Information Systems degree focused on software engineering, business analysis,
            systems analysis and design, databases, and information technology.
          </p>

          <div class="education-highlights">
            <p>
              <strong>Leadership & Activities:</strong>
              <strong> Treasurer</strong> of the Rotaract Club of UCSC, with prior experience as a
              Professional Development Committee Member. Participated in Rowing, Scrabble, and
              Hockey during the Freshers' period.
            </p>
          </div>
        </article>

        <!-- G.C.E. Advanced Level -->
        <article class="education-item">
          <div class="education-header">
            <div>
              <h3>G.C.E. Advanced Level</h3>
              <p class="education-institution">Hindu College Colombo</p>
            </div>

            <span class="education-date">2022</span>
          </div>

          <p class="education-description">
            Completed the G.C.E. Advanced Level examination with a focus on the Mathematics stream.
          </p>

          <div class="education-highlights">
            <p>
              <strong>Activities: </strong>
              Represented the school in hockey and served as a school prefect.
            </p>
          </div>
        </article>

        <!-- G.C.E. Ordinary Level -->
        <article class="education-item">
          <div class="education-header">
            <div>
              <h3>G.C.E. Ordinary Level</h3>
              <p class="education-institution">Hindu College Colombo</p>
            </div>

            <span class="education-date">2018</span>
          </div>

          <p class="education-description">Completed the G.C.E. Ordinary Level examination.</p>
        </article>
      </div>
    </section>
    <footer class="site-footer">
      <p>© 2026 Vidurshan Ponmudy. All rights reserved.</p>
    </footer>
  </main>
</Layout>
